# Repo root on the Docker host. DockerOperator bind-mounts from the host
# filesystem, so this cannot be inferred inside the Airflow container.
HOST_PROJECT_DIR=/absolute/path/to/claims-policy-analytics-pipeline

# Root of the Databricks Git folder holding the synced notebooks.
DATABRICKS_NOTEBOOK_BASE=/Workspace/Users/<your-user>/Flood-analytics-pipeline/notebooks

# Host UID so container-written files aren't owned by root.
AIRFLOW_UID=50000